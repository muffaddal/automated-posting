# Telegram: create a bot via @BotFather, add it as admin to a public channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@your_channel

# Mastodon: Preferences > Development > New application (write:statuses)
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Bluesky: Settings > Privacy and security > App passwords
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# GitHub: personal access token with the "gist" scope
GITHUB_TOKEN=

# Dev.to: Settings > Extensions > DEV Community API Keys
DEVTO_API_KEY=

# Discord: Channel settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=
DISCORD_GUILD_ID=
